<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>kioskSettings_v2</key>
    <array>

        <!-- ============================================ -->
        <!-- BASE CONFIG — applied to ALL iPads first     -->
        <!-- Settings common across all kiosk groups.     -->
        <!-- ============================================ -->
        <dict>
            <!-- Display -->
            <key>showAddressBar</key>
            <false/>
            <key>showStatusBar</key>
            <false/>

            <!-- Memory & Privacy -->
            <key>clearCookies</key>
            <true/>
            <key>clearCache</key>
            <true/>

            <!-- Brightness & Power -->
            <key>kp_isControlBrightnessInKioskEnabled</key>
            <true/>
            <key>manualControlOfBrightness</key>
            <real>0.75</real>
            <key>reduceBrightnessTimeInterval</key>
            <string>300</string>
            <key>kp_applyReduceBrightness</key>
            <real>0.5</real>
            <key>allowAutoLock</key>
            <false/>

            <!-- Night Mode display behavior (shared across groups) -->
            <!-- If you want these different per group, move them to -->
            <!-- each override section below.                         -->
            <key>kp_nightMode_isDisplayBlackBackgroundEnabled</key>
            <true/>
            <key>kp_nightMode_isAllowInterruptionByTouchEnabled</key>
            <true/>

            <!-- Admin -->
            <key>settingsPassCode</key>
            <string>6341</string>
            <key>showSettings</key>
            <integer>1</integer>

            <!-- Interaction -->
            <key>kp_preventDragAndDrop</key>
            <true/>
        </dict>

        <!-- ============================================ -->
        <!-- LIBRARY OVERRIDES — MDYLibrary* iPads        -->
        <!-- Night Mode schedule: Mon-Thu dim 17:30,      -->
        <!--                      Fri dim 14:45           -->
        <!-- ============================================ -->
        <dict>
            <!-- Content -->
            <key>homePage</key>
            <string>https://mdy.follettdestiny.com/portal/portal?app=Destiny%20Discover&amp;appId=destiny-5CGD-9BBN&amp;siteGuid=DCB35BD0-A9CF-472E-97A5-5A11D267D71F</string>

            <!-- Content Refresh -->
            <key>idleTime</key>
            <string>20</string>
            <key>refreshTime</key>
            <string>30</string>

            <!-- Visitor Management -->
            <key>kp_allowedDomains</key>
            <string>follettdestiny.com;follett.com;follettsoftware.com</string>

            <!-- Night Mode schedule (Library-specific) -->
            <key>sleepSchedullerEnabled</key>
            <true/>
            <key>time_1</key>
            <string>Monday 17:30</string>
            <key>time_3</key>
            <string>Tuesday 17:30</string>
            <key>time_5</key>
            <string>Wednesday 17:30</string>
            <key>time_7</key>
            <string>Thursday 17:30</string>
            <key>time_9</key>
            <string>Friday 14:45</string>

            <!-- Apply only to devices whose name starts with MDYLibrary -->
            <key>ApplyTo</key>
            <array>
                <string>MDYLibrary*</string>
            </array>
        </dict>

        <!-- ============================================ -->
        <!-- ES LOBBY KIOSK OVERRIDES — MDYESLobbyKiosk*  -->
        <!-- Night Mode schedule: PLACEHOLDER — customize -->
        <!-- before rollout.                              -->
        <!-- ============================================ -->
        <dict>
            <!-- Content -->
            <key>homePage</key>
            <string>https://mdy.parentlocker.com/app/main/kiosk/136aef3c-7a3e-4cf5-b16b-a44988a95966</string>

            <!-- Content Refresh -->
            <key>idleTime</key>
            <string>30</string>

            <!-- Visitor Management -->
            <key>kp_allowedDomains</key>
            <string>mdy.parentlocker.com;parentlocker.com</string>

            <!-- Night Mode schedule (ES Lobby-specific — PLACEHOLDER) -->
            <key>sleepSchedullerEnabled</key>
            <true/>
            <key>time_1</key>
            <string>Monday 17:30</string>
            <key>time_3</key>
            <string>Tuesday 17:30</string>
            <key>time_5</key>
            <string>Wednesday 17:30</string>
            <key>time_7</key>
            <string>Thursday 17:30</string>
            <key>time_9</key>
            <string>Friday 14:45</string>

            <!-- Apply only to devices whose name starts with MDYESLobbyKiosk -->
            <key>ApplyTo</key>
            <array>
                <string>MDYESLobbyKiosk*</string>
            </array>
        </dict>

        <!-- ============================================ -->
        <!-- ROAMING iPADS — Lobby / Auditorium / Midrash -->
        <!--                                              -->
        <!-- These iPads move between physical locations. -->
        <!-- The homepage is a hosted launcher page that  -->
        <!-- lets staff select a location (passcode-      -->
        <!-- gated). Selection is stored in browser       -->
        <!-- localStorage on the iPad, so subsequent      -->
        <!-- refreshes auto-redirect to the selected      -->
        <!-- ParentLocker URL.                            -->
        <!--                                              -->
        <!-- IMPORTANT:                                   -->
        <!-- * clearDataOnRelaunch is disabled so the     -->
        <!--   stored mode survives remote settings       -->
        <!--   updates and overnight relaunches.          -->
        <!-- * Allowed domains MUST include the launcher  -->
        <!--   host (GitHub Pages).                       -->
        <!-- ============================================ -->
        <dict>
            <!-- Content: launcher page -->
            <!-- REPLACE with your actual GitHub Pages URL -->
            <key>homePage</key>
            <string>https://YOUR-USERNAME.github.io/mdy-kiosk-configs/launcher.html</string>

            <!-- Content Refresh -->
            <key>idleTime</key>
            <string>30</string>

            <!-- Visitor Management — allow launcher + both ParentLocker URLs -->
            <!-- REPLACE YOUR-USERNAME.github.io with your actual host -->
            <key>kp_allowedDomains</key>
            <string>YOUR-USERNAME.github.io;mdy.parentlocker.com;parentlocker.com</string>

            <!-- Preserve localStorage across relaunches + remote setting updates -->
            <!-- (required for the launcher to remember the selected mode) -->
            <key>clearDataOnRelaunch</key>
            <false/>

            <!-- Night Mode schedule (roaming iPads — PLACEHOLDER) -->
            <key>sleepSchedullerEnabled</key>
            <true/>
            <key>time_1</key>
            <string>Monday 17:30</string>
            <key>time_3</key>
            <string>Tuesday 17:30</string>
            <key>time_5</key>
            <string>Wednesday 17:30</string>
            <key>time_7</key>
            <string>Thursday 17:30</string>
            <key>time_9</key>
            <string>Friday 14:45</string>

            <!-- Apply to all three roaming-iPad name prefixes -->
            <!-- NOTE: MDYLobby* correctly does NOT match MDYESLobbyKiosk* -->
            <key>ApplyTo</key>
            <array>
                <string>MDYLobby*</string>
                <string>MDYAuditorium*</string>
                <string>MDYMidrash*</string>
            </array>
        </dict>

    </array>
</dict>
</plist>
