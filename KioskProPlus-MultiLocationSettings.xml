<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
 "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>kioskSettings_v2</key>
		<array>
			<!--  ============================================  -->
			<!--  BASE CONFIG — applied to ALL iPads first      -->
			<!--  Settings common across all kiosk groups.      -->
			<!--  ============================================  -->
			<dict>
				<!--  Display  -->
				<key>showAddressBar</key>
				<false/>
				<key>showStatusBar</key>
				<false/>
				<!--  Memory & Privacy  -->
				<key>clearCookies</key>
				<true/>
				<key>clearCache</key>
				<true/>
				<!--  Brightness & Power  -->
				<key>kp_isControlBrightnessInKioskEnabled</key>
				<true/>
				<key>manualControlOfBrightness</key>
				<real>0.75</real>
				<key>reduceBrightnessTimeInterval</key>
				<string>300</string>
				<key>kp_applyReduceBrightness</key>
				<real>0.6</real>
				<key>allowAutoLock</key>
				<false/>
				<!--  Night Mode display behavior (shared across groups)  -->
				<!--  If you want these different per group, move them to  -->
				<!--  each override section below.                          -->
				<key>kp_nightMode_isDisplayBlackBackgroundEnabled</key>
				<true/>
				<key>kp_nightMode_isAllowInterruptionByTouchEnabled</key>
				<false/>
				<!--  Admin  -->
				<key>settingsPassCode</key>
				<string>6341</string>
				<key>showSettings</key>
				<integer>1</integer>
				<key>settingsShowingOption</key>
				<integer>2</integer>
				<!--  Interaction  -->
				<key>kp_preventDragAndDrop</key>
				<true/>
			</dict>
			<!--  ============================================  -->
			<!--  LIBRARY OVERRIDES — MDYLibrary* iPads         -->
			<!--  Night Mode schedule: Mon-Thu dim 17:30,       -->
			<!--                       Fri dim 14:45            -->
			<!--  ============================================  -->
			<dict>
				<!--  Content  -->
				<key>homePage</key>
                <string>https://mdy.follettdestiny.com/portal/portal?app=Destiny%20Discover&amp;appId=destiny-5CGD-9BBN&amp;siteGuid=DCB35BD0-A9CF-472E-97A5-5A11D267D71F</string>
				<!--  Content Refresh  -->
				<key>idleTime</key>
				<string>20</string>
				<key>refreshTime</key>
				<string>30</string>
				<!--  Settings access: 1 = Touch Gesture + Passcode     -->
				<!--  (NOT shown on launch/reboot)                       -->
				<key>showSettings</key>
				<integer>1</integer>
				<!--  Visitor Management  -->
				<key>kp_allowedDomains</key>
				<string>mdyhs.github.io;follettdestiny.com;follett.com;follettsoftware.com</string>
				<!--  Night Mode schedule (Library-specific)  -->
				<key>sleepSchedullerEnabled</key>
				<true/>
				<key>time_1</key>
				<string>Monday 17:30</string>
				<key>time_3</key>
				<string>Tuesday 17:30</string>
				<key>time_5</key>
				<string>Wednesday 17:30</string>
				<key>time_7</key>
				<string>Thursday 17:30</string>
				<key>time_9</key>
				<string>Friday 14:45</string>
				<!--  Apply only to devices whose name starts with MDYLibrary  -->
				<key>ApplyTo</key>
				<array>
					<string>MDYLibrary*</string>
				</array>
			</dict>
			<!--  ============================================  -->
			<!--  ES LOBBY KIOSK OVERRIDES — MDYESLobbyKiosk*   -->
			<!--  Active window: Mon-Fri 07:00–08:45            -->
			<!--  ============================================  -->
			<dict>
				<!--  Content  -->
				<key>homePage</key>
				<string>https://mdy.parentlocker.com/app/main/kiosk/136aef3c-7a3e-4cf5-b16b-a44988a95966</string>
				<!--  Content Refresh — DISABLED (ParentLocker handles  -->
				<!--  per-visitor reset internally)                     -->
				<key>idleTime</key>
				<string>0</string>
				<key>refreshTime</key>
				<string>0</string>
				<!--  Settings access: 1 = Touch Gesture + Passcode     -->
				<!--  (NOT shown on launch/reboot)                       -->
				<key>showSettings</key>
				<integer>1</integer>
				<!--  Visitor Management  -->
				<key>kp_allowedDomains</key>
				<string>mdyhs.github.io;mdy.parentlocker.com;parentlocker.com</string>
				<!--  Night Mode schedule (wake/dim pairs, time_0..time_9)  -->
				<!--  Even index = Wake, Odd index = Dim                    -->
				<key>sleepSchedullerEnabled</key>
				<true/>
				<key>time_0</key>
				<string>Monday 07:00</string>
				<key>time_1</key>
				<string>Monday 08:45</string>
				<key>time_2</key>
				<string>Tuesday 07:00</string>
				<key>time_3</key>
				<string>Tuesday 08:45</string>
				<key>time_4</key>
				<string>Wednesday 07:00</string>
				<key>time_5</key>
				<string>Wednesday 08:45</string>
				<key>time_6</key>
				<string>Thursday 07:00</string>
				<key>time_7</key>
				<string>Thursday 08:45</string>
				<key>time_8</key>
				<string>Friday 07:00</string>
				<key>time_9</key>
				<string>Friday 08:45</string>
				<!--  Apply only to devices whose name starts with MDYESLobbyKiosk  -->
				<key>ApplyTo</key>
				<array>
					<string>MDYESLobbyKiosk*</string>
				</array>
			</dict>
			<!--  ============================================  -->
			<!--  ES LOBBY DESK OVERRIDES — MDYESLobbyDesk*     -->
			<!--  Active window: Mon-Thu 07:00–14:00            -->
			<!--                 Fri     07:00–12:00            -->
			<!--  Staffed front-desk station; longer uptime.    -->
			<!--  ============================================  -->
			<dict>
				<!--  Content  -->
				<key>homePage</key>
				<string>https://mdy.parentlocker.com/app/main/kiosk/136aef3c-7a3e-4cf5-b16b-a44988a95966</string>
				<!--  Content Refresh — DISABLED (ParentLocker handles  -->
				<!--  per-visitor reset internally)                     -->
				<key>idleTime</key>
				<string>0</string>
				<key>refreshTime</key>
				<string>0</string>
				<!--  Settings access: 1 = Touch Gesture + Passcode     -->
				<!--  (NOT shown on launch/reboot)                       -->
				<key>showSettings</key>
				<integer>1</integer>
				<!--  Visitor Management  -->
				<key>kp_allowedDomains</key>
				<string>mdyhs.github.io;mdy.parentlocker.com;parentlocker.com</string>
				<!--  Night Mode schedule (wake/dim pairs, time_0..time_9)  -->
				<!--  Even index = Wake, Odd index = Dim                    -->
				<key>sleepSchedullerEnabled</key>
				<true/>
				<key>time_0</key>
				<string>Monday 07:00</string>
				<key>time_1</key>
				<string>Monday 14:00</string>
				<key>time_2</key>
				<string>Tuesday 07:00</string>
				<key>time_3</key>
				<string>Tuesday 14:00</string>
				<key>time_4</key>
				<string>Wednesday 07:00</string>
				<key>time_5</key>
				<string>Wednesday 14:00</string>
				<key>time_6</key>
				<string>Thursday 07:00</string>
				<key>time_7</key>
				<string>Thursday 14:00</string>
				<key>time_8</key>
				<string>Friday 07:00</string>
				<key>time_9</key>
				<string>Friday 12:00</string>
				<!--  Apply only to devices whose name starts with MDYESLobbyDesk  -->
				<key>ApplyTo</key>
				<array>
					<string>MDYESLobbyDesk*</string>
				</array>
			</dict>
			<!--  ============================================  -->
			<!--  AUDITORIUM OVERRIDES - MDYAuditorium1 ONLY    -->
			<!--  Rack iPad running the Home Assistant AV        -->
			<!--  control dashboard. Added 2026-08-17.           -->
			<!--                                                 -->
			<!--  ApplyTo is the EXACT name, not MDYAuditorium*,  -->
			<!--  because MDYAuditorium2 has a different purpose. -->
			<!--  ============================================  -->
			<dict>
				<!--  Content: the HA LOCK view, not the dashboard.       -->
				<!--  Kiosk Pro's idle timer returns to homePage, so      -->
				<!--  pointing it here makes the iPad lock itself after   -->
				<!--  idleTime. Unlock is a PIN pad inside HA.            -->
				<!--  Side effect: it also boots/relaunches locked.       -->
				<key>homePage</key>
				<string>http://10.10.222.20:8123/dashboard-auditorium/lock</string>
				<!--  Content Refresh: 5400s = 90 min idle -> back to     -->
				<!--  homePage (= locked). refreshTime 0 so it never      -->
				<!--  reloads mid-show.                                   -->
				<key>idleTime</key>
				<string>5400</string>
				<key>refreshTime</key>
				<string>0</string>
				<!--  Settings access: 1 = Touch Gesture + Passcode       -->
				<key>showSettings</key>
				<integer>1</integer>
				<!--  Visitor Management. HA is reached by IP over plain   -->
				<!--  http (the dashboard embeds the Shelly screen page,  -->
				<!--  and an https page cannot iframe http).              -->
				<key>kp_allowedDomains</key>
				<string>mdyhs.github.io;10.10.222.20;10.10.222.55</string>
				<!--  Screen "sleep" at 30 min idle. iPad Auto-Lock only  -->
				<!--  offers up to 15 min and allowAutoLock is false in    -->
				<!--  the BASE config, so this dims the backlight to      -->
				<!--  black instead: 1800s idle -> brightness 0.0.        -->
				<!--  Overrides the BASE 300s / 0.6.                      -->
				<key>reduceBrightnessTimeInterval</key>
				<string>1800</string>
				<key>kp_applyReduceBrightness</key>
				<real>0.0</real>
				<!--  No Night Mode schedule: the auditorium runs evening -->
				<!--  events, so a fixed dim/wake window is wrong here.   -->
				<key>sleepSchedullerEnabled</key>
				<false/>
				<!--  Apply ONLY to this one iPad  -->
				<key>ApplyTo</key>
				<array>
					<string>MDYAuditorium1</string>
				</array>
			</dict>
		</array>
	</dict>
</plist>
