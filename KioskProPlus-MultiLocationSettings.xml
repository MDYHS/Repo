<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
 "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>kioskSettings_v2</key>
		<array>
			<!--  ============================================  -->
			<!--  BASE CONFIG — applied to ALL iPads first      -->
			<!--  Settings common across all kiosk groups.      -->
			<!--  ============================================  -->
			<dict>
				<!--  Display  -->
				<key>showAddressBar</key>
				<false/>
				<key>showStatusBar</key>
				<false/>
				<!--  Memory & Privacy  -->
				<key>clearCookies</key>
				<true/>
				<key>clearCache</key>
				<true/>
				<!--  Brightness & Power  -->
				<key>kp_isControlBrightnessInKioskEnabled</key>
				<true/>
				<key>manualControlOfBrightness</key>
				<real>0.75</real>
				<key>reduceBrightnessTimeInterval</key>
				<string>300</string>
				<key>kp_applyReduceBrightness</key>
				<real>0.5</real>
				<key>allowAutoLock</key>
				<false/>
				<!--  Night Mode display behavior (shared across groups)  -->
				<!--  If you want these different per group, move them to  -->
				<!--  each override section below.                          -->
				<key>kp_nightMode_isDisplayBlackBackgroundEnabled</key>
				<true/>
				<key>kp_nightMode_isAllowInterruptionByTouchEnabled</key>
				<true/>
				<!--  Admin  -->
				<key>settingsPassCode</key>
				<string>6341</string>
				<key>showSettings</key>
				<integer>1</integer>
				<!--  Interaction  -->
				<key>kp_preventDragAndDrop</key>
				<true/>
			</dict>
			<!--  ============================================  -->
			<!--  LIBRARY OVERRIDES — MDYLibrary* iPads         -->
			<!--  Night Mode schedule: Mon-Thu dim 17:30,       -->
			<!--                       Fri dim 14:45            -->
			<!--  ============================================  -->
			<dict>
				<!--  Content  -->
				<key>homePage</key>
                <string>https://mdy.follettdestiny.com/portal/portal?app=Destiny%20Discover&amp;appId=destiny-5CGD-9BBN&amp;siteGuid=DCB35BD0-A9CF-472E-97A5-5A11D267D71F</string>
				<!--  Content Refresh  -->
				<key>idleTime</key>
				<string>20</string>
				<key>refreshTime</key>
				<string>30</string>
				<!--  Visitor Management  -->
				<key>kp_allowedDomains</key>
				<string>mdyhs.github.io;follettdestiny.com;follett.com;follettsoftware.com</string>
				<!--  Night Mode schedule (Library-specific)  -->
				<key>sleepSchedullerEnabled</key>
				<true/>
				<key>time_1</key>
				<string>Monday 17:30</string>
				<key>time_3</key>
				<string>Tuesday 17:30</string>
				<key>time_5</key>
				<string>Wednesday 17:30</string>
				<key>time_7</key>
				<string>Thursday 17:30</string>
				<key>time_9</key>
				<string>Friday 14:45</string>
				<!--  Apply only to devices whose name starts with MDYLibrary  -->
				<key>ApplyTo</key>
				<array>
					<string>MDYLibrary*</string>
				</array>
			</dict>
			<!--  ============================================  -->
			<!--  ES LOBBY KIOSK OVERRIDES — MDYESLobbyKiosk*   -->
			<!--  Active window: Mon-Thu 07:00–08:45            -->
			<!--                 Fri     07:00–12:00            -->
			<!--  Morning drop-off / arrival self-service.      -->
			<!--  ParentLocker handles per-visitor reset        -->
			<!--  internally, so Kiosk Pro timers are relaxed.  -->
			<!--  ============================================  -->
			<dict>
				<!--  Content  -->
				<key>homePage</key>
				<string>https://mdy.parentlocker.com/app/main/kiosk/136aef3c-7a3e-4cf5-b16b-a44988a95966</string>
				<!--  Content Refresh (idleTime=seconds, refreshTime=minutes)  -->
				<key>idleTime</key>
				<string>3600</string>
				<key>refreshTime</key>
				<string>60</string>
				<!--  Visitor Management  -->
				<key>kp_allowedDomains</key>
				<string>mdyhs.github.io;mdy.parentlocker.com;parentlocker.com</string>
				<!--  Night Mode schedule (wake/dim pairs, time_0..time_9)  -->
				<!--  Even index = Wake, Odd index = Dim                    -->
				<key>sleepSchedullerEnabled</key>
				<true/>
				<key>time_0</key>
				<string>Monday 07:00</string>
				<key>time_1</key>
				<string>Monday 08:45</string>
				<key>time_2</key>
				<string>Tuesday 07:00</string>
				<key>time_3</key>
				<string>Tuesday 08:45</string>
				<key>time_4</key>
				<string>Wednesday 07:00</string>
				<key>time_5</key>
				<string>Wednesday 08:45</string>
				<key>time_6</key>
				<string>Thursday 07:00</string>
				<key>time_7</key>
				<string>Thursday 08:45</string>
				<key>time_8</key>
				<string>Friday 07:00</string>
				<key>time_9</key>
				<string>Friday 08:45</string>
				<!--  Apply only to devices whose name starts with MDYESLobbyKiosk  -->
				<key>ApplyTo</key>
				<array>
					<string>MDYESLobbyKiosk*</string>
				</array>
			</dict>
			<!--  ============================================  -->
			<!--  ES LOBBY DESK OVERRIDES — MDYESLobbyDesk*     -->
			<!--  Active window: Mon-Thu 07:00–14:00            -->
			<!--                 Fri     07:00–12:00            -->
			<!--  Staffed front-desk station; longer uptime.    -->
			<!--  Same ParentLocker endpoint and allowed        -->
			<!--  domains as the Kiosk profile.                 -->
			<!--  ============================================  -->
			<dict>
				<!--  Content  -->
				<key>homePage</key>
				<string>https://mdy.parentlocker.com/app/main/kiosk/136aef3c-7a3e-4cf5-b16b-a44988a95966</string>
				<!--  Content Refresh (idleTime=seconds, refreshTime=minutes)  -->
				<key>idleTime</key>
				<string>3600</string>
				<key>refreshTime</key>
				<string>60</string>
				<!--  Visitor Management  -->
				<key>kp_allowedDomains</key>
				<string>mdyhs.github.io;mdy.parentlocker.com;parentlocker.com</string>
				<!--  Night Mode schedule (wake/dim pairs, time_0..time_9)  -->
				<!--  Even index = Wake, Odd index = Dim                    -->
				<key>sleepSchedullerEnabled</key>
				<true/>
				<key>time_0</key>
				<string>Monday 07:00</string>
				<key>time_1</key>
				<string>Monday 14:00</string>
				<key>time_2</key>
				<string>Tuesday 07:00</string>
				<key>time_3</key>
				<string>Tuesday 14:00</string>
				<key>time_4</key>
				<string>Wednesday 07:00</string>
				<key>time_5</key>
				<string>Wednesday 14:00</string>
				<key>time_6</key>
				<string>Thursday 07:00</string>
				<key>time_7</key>
				<string>Thursday 14:00</string>
				<key>time_8</key>
				<string>Friday 07:00</string>
				<key>time_9</key>
				<string>Friday 12:00</string>
				<!--  Apply only to devices whose name starts with MDYESLobbyDesk  -->
				<key>ApplyTo</key>
				<array>
					<string>MDYESLobbyDesk*</string>
				</array>
			</dict>
		</array>
	</dict>
</plist>
